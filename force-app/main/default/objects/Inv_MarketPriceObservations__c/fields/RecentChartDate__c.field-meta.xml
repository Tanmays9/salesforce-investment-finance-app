<?xml version='1.0' encoding='UTF-8'?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>RecentChartDate__c</fullName>
  <formula>AND(NOT(ISBLANK(ObservedOn__c)), ObservedOn__c &gt;= ADDMONTHS(TODAY(), -60))</formula>
  <label>Within five year chart window</label>
  <type>Checkbox</type>
</CustomField>